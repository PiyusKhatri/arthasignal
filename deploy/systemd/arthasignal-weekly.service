[Unit]
Description=Weekly Discord report
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=arthasignal-notify@%n.service

[Service]
Type=oneshot
User=arthasignal
Group=arthasignal
WorkingDirectory=/srv/arthasignal/app
EnvironmentFile=/srv/arthasignal/app/.env
Environment=TZ=Asia/Kathmandu PYTHONUNBUFFERED=1
ExecStart=/srv/arthasignal/app/.venv/bin/python -m src.ops.report weekly
TimeoutStartSec=15min
Nice=5
