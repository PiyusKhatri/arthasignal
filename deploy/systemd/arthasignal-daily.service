[Unit]
Description=Post-close chain: capture, quarterly, news, integrity, league, avoid writer, tips, grading, metrics, report
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=arthasignal-notify@%n.service

[Service]
Type=oneshot
User=arthasignal
Group=arthasignal
WorkingDirectory=/srv/arthasignal/app
EnvironmentFile=/srv/arthasignal/app/.env
Environment=TZ=Asia/Kathmandu PYTHONUNBUFFERED=1
ExecStart=/srv/arthasignal/app/.venv/bin/python -m src.ops.daily
TimeoutStartSec=10h
Nice=5
