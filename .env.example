# Local PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql+psycopg2://artha:artha_local_password@127.0.0.1:5432/artha
# Optional read replica. Leave blank to reuse DATABASE_URL.
DATABASE_URL_READONLY=

# Required for login/signup/refresh/protected API operations.
# Generate a long random value for every real environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# URL used when password-reset emails build the browser link.
FRONTEND_BASE_URL=http://localhost:3000

# Password-reset delivery. Forgot-password stays generic and issues no usable
# reset token if these are not configured correctly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional operational integrations.
DISCORD_WEBHOOK_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
